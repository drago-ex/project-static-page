extensions:
	# Texy, its toolbar and the code highlighter (drago-ex/texy-toolbar); other packages may register it too
	texy: Drago\Texy\DI\TexyExtension

services:

	# before the front router (9.conf.neon), whose <presenter>/<action> would take every address
	router: {setup: {add(@router.page)}}
	router.page: {factory: App\Presentation\Front\Page\PageRouter::create, autowired: no}
	- App\Model\Page\PageSlugs
