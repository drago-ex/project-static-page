{
	"name": "drago-ex/project-static-page",
	"description": "Static page administration for Drago Project.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"nette/application": "^3.2",
		"nette/di": "^3.2",
		"nette/caching": "^3.3",
		"drago-ex/application": "^3.0 || ^4.0",
		"drago-ex/component": "^2.0 || ^3.0",
		"drago-ex/database": "^3.0 || ^4.0",
		"drago-ex/datagrid": "^2.0",
		"drago-ex/form": "^3.0",
		"drago-ex/migration": "^2.3",
		"drago-ex/project-auth": "^2.0",
		"drago-ex/project-backend": "^2.0",
		"drago-ex/translator": "^4.0 || ^5.0",
		"drago-ex/utils": "^2.0",
		"drago-ex/texy-toolbar": "^1.0"
	},
	"suggest": {
		"drago-ex/permission": "Generates the access rules of the page administration and the pages (permission.php).",
		"drago-ex/project-permission": "Role and permission management in the administration, which registers the generated providers.",
		"drago-ex/project-backend-ui": "Administration layout; the page administration uses its content widget."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^2.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app/Model": "app/Model",
					"resources/app/Presentation/Backend": "app/Presentation/Backend",
					"resources/app/Presentation/Front": "app/Presentation/Front"
				}
			}
		},
		"drago-permission": "permission.php",
		"drago-translator": {
			"translation": "app/Presentation/Backend/Page/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
